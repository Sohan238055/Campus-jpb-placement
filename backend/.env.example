# MongoDB connection string (MongoDB Atlas recommended for Vercel deployment)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
DB_NAME=college

# Long random string used to sign session cookies
SESSION_SECRET=change-this-to-a-long-random-string

# The deployed frontend URL (needed for CORS + cross-domain cookies)
FRONTEND_URL=https://your-frontend.vercel.app

# Set to "production" on Vercel so cookies are set as Secure/SameSite=None
NODE_ENV=production

# Only used for local dev (server.js). Not used on Vercel.
PORT=5000
